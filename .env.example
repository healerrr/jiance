# SQLite 文件相对于 prisma/schema.prisma 所在目录解析。
DATABASE_URL="file:./dev.db"

# 用于 AES-256-GCM 加密模型 API 密钥。生产环境请使用至少 32 位随机字符串。
ENCRYPTION_MASTER_KEY="replace-with-a-long-random-secret-at-least-32-characters"

# 可选：设置后，数据库初始化或生产服务启动时会自动配置三个百炼模型。
BAILIAN_API_KEY="replace-with-your-bailian-api-key"

# 可选：浏览器端显示的站点地址。
NUXT_PUBLIC_APP_BASE_URL="http://127.0.0.1:3000"
