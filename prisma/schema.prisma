generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ModelConfig {
  id              String    @id @default(cuid())
  name            String    @unique
  apiBaseUrl      String
  apiKeyEncrypted String
  modelName       String
  temperature     Float     @default(0.3)
  maxOutputTokens Int       @default(2000)
  timeoutMs       Int       @default(60000)
  enabled         Boolean   @default(true)
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messages        Message[]

  @@index([enabled, isDefault], map: "idx_model_configs_enabled_default")
}

model Conversation {
  id                      String    @id @default(cuid())
  externalKey             String    @unique
  title                   String
  cas                     String
  testProject             String
  sampleName              String?
  sampleCode              String?
  confirmedContent        String
  metadataJson            String?
  summary                 String?
  summaryMessageCount     Int       @default(0)
  status                  String    @default("active")
  currentModelConfigId    String?
  currentModelName        String?
  activeGenerationId      String?
  activeGenerationStarted DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  lastMessageAt           DateTime  @default(now())
  messages                Message[]

  @@index([lastMessageAt], map: "idx_conversations_last_message_at")
  @@index([cas], map: "idx_conversations_cas")
  @@index([testProject], map: "idx_conversations_test_project")
}

model Message {
  id                String       @id @default(cuid())
  conversationId    String
  role              String
  content           String
  status            String       @default("completed")
  modelConfigId     String?
  modelNameSnapshot String?
  errorSummary      String?
  createdAt         DateTime     @default(now())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  modelConfig        ModelConfig? @relation(fields: [modelConfigId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt], map: "idx_messages_conversation_created_at")
  @@index([conversationId, role], map: "idx_messages_conversation_role")
}

model AppSetting {
  id                String   @id @default("global")
  globalSystemPrompt String
  contextMaxMessages Int     @default(20)
  contextMaxChars    Int     @default(40000)
  updatedAt          DateTime @updatedAt
}
